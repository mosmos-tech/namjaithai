# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก: npx supabase status -o env
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=ใส่ค่า_PUBLISHABLE_KEY
# คีย์ลับสำหรับฝั่งเซิร์ฟเวอร์เท่านั้น (ห้ามขึ้นต้นด้วย NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=ใส่ค่า_SECRET_KEY

# LINE Login (TF-17) — จาก LINE Developers Console → LINE Login channel → Basic settings
# ใช้แค่ตอนรัน npm run auth:setup-line (ลงทะเบียน LINE ใน Supabase) เว็บไม่ได้อ่านเอง
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# LINE user ID ของแอดมินชุดแรก (ขึ้นต้นด้วย U) คั่นด้วยจุลภาค — ล็อกอินแล้วเป็นแอดมินอัตโนมัติ
SUPER_ADMIN_LINE_IDS=

# TF-43: optional LINE Messaging API (separate from LINE Login; same provider).
# Configure only on the server. Leave blank until an Official Account is ready.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Random server secret, at least 16 characters, for POST /api/notifications/line.
LINE_NOTIFICATIONS_SECRET=
# Public canonical HTTPS origin used in tracking links sent by the bot.
APP_BASE_URL=
