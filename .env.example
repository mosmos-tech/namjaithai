# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก: npx supabase status -o env
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=ใส่ค่า_PUBLISHABLE_KEY
# คีย์ลับสำหรับฝั่งเซิร์ฟเวอร์เท่านั้น (ห้ามขึ้นต้นด้วย NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=ใส่ค่า_SECRET_KEY

# TF-64: สภาพแวดล้อม (development | dev | uat | production) — dev/uat มีแถบสีบอกบนหัวเว็บ
# ในเครื่องใช้ development · ค่าบน Vercel ตั้งตามตารางใน docs/environments.md
NEXT_PUBLIC_APP_ENV=development

# LINE Login (TF-17) — จาก LINE Developers Console → LINE Login channel → Basic settings
# ใช้แค่ตอนรัน npm run auth:setup-line (ลงทะเบียน LINE ใน Supabase) เว็บไม่ได้อ่านเอง
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# LINE user ID ของแอดมินชุดแรก (ขึ้นต้นด้วย U) คั่นด้วยจุลภาค — ล็อกอินแล้วเป็นแอดมินอัตโนมัติ
SUPER_ADMIN_LINE_IDS=

# TF-43: optional LINE Messaging API (separate from LINE Login; same provider).
# Configure only on the server. Leave blank until an Official Account is ready.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Random server secret, at least 16 characters, for POST /api/notifications/line.
LINE_NOTIFICATIONS_SECRET=
# Public canonical HTTPS origin used in tracking links sent by the bot.
APP_BASE_URL=

# TF-36: SOS ผ่าน SMS (มือถือ Android + ซิม + แอป httpSMS) — วิธีตั้งเครื่องดู docs/sms-gateway.md
# เบอร์ซิมในเครื่อง gateway (เช่น 0812345678) — ไม่ได้ตั้ง = ปุ่ม "ส่งทาง SMS" เปิดแอปข้อความแบบไม่มีเบอร์
NEXT_PUBLIC_SMS_GATEWAY_NUMBER=
# Signing key ที่ตั้งตอนสร้าง webhook ใน httpSMS (ใช้ตรวจว่า webhook มาจากเครื่องเราจริง)
HTTPSMS_WEBHOOK_SIGNING_KEY=
# API key จาก https://httpsms.com/settings — ไม่ได้ตั้ง = ไม่ส่ง SMS ตอบกลับ (ผลยังบันทึกในฐานข้อมูล)
HTTPSMS_API_KEY=

# TF-27: สวิตช์ปิด Supabase Realtime ทั้งระบบ (ค่าเริ่มต้นเปิด = true; ตั้งเป็น false เพื่อใช้โหมดดึงทุก 15 วินาทีโดยไม่เปิด WebSocket)
# NEXT_PUBLIC_REALTIME_ENABLED=true
